PORT=4000
# Origem do frontend permitida (CORS)
ALLOWED_ORIGIN=https://mail.dfalog.com.br
# Chave de 32 bytes em hex para criptografar senhas na sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=
# Duração da sessão em horas
SESSION_TTL_HOURS=12
# Servidores Hostinger
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Domínios permitidos para login (separados por vírgula)
ALLOWED_DOMAINS=dfalog.com.br
